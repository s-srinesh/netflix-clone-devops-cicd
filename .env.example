# ==========================================
# Netflix Clone Configuration (.env)
# ==========================================

# Server & Node Configuration
SERVER_PORT=8000
NODE_ENV=development

# Client Configuration
CLIENT_HOST=localhost
CLIENT_PORT=5173
CLIENT_URL=http://localhost:5173

# AWS RDS MySQL Database Configuration
# For AWS RDS, DB_HOST will be: your-db-instance.xxxxxx.us-east-1.rds.amazonaws.com
# For local development with Docker, DB_HOST can be: localhost
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=netflix_db
# Set DB_SSL to true when connecting to AWS RDS requiring SSL certificate verification
DB_SSL=false

# Authentication / JWT
JWT_SECRET=your_jwt_super_secret_key_change_in_production

# TMDB API (The Movie Database) - https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key

# Mailtrap Transactional Email Service - https://mailtrap.io
MAILTRAP_TOKEN=your_mailtrap_token
MAILTRAP_ENDPOINT=https://sandbox.api.mailtrap.io/api/send/your_mailbox_id
