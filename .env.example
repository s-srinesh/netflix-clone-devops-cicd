# ==========================================
# Netflix Clone Configuration (.env)
# ==========================================

# Server & Node Configuration
SERVER_PORT=8000
NODE_ENV=development

# Client Configuration
CLIENT_HOST=localhost
CLIENT_PORT=5173
CLIENT_URL=http://localhost:5173

# AWS Aurora / RDS PostgreSQL Database Configuration
# For AWS Aurora / RDS, DB_HOST is your Endpoint (e.g., database-1.cluster-xxxxxx.ap-southeast-1.rds.amazonaws.com)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgresql_password
DB_NAME=postgres
# Set DB_SSL to true when connecting to AWS Aurora / RDS PostgreSQL
DB_SSL=true

# Authentication / JWT
JWT_SECRET=your_jwt_super_secret_key_change_in_production

# TMDB API (The Movie Database) - https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key

# Mailtrap Transactional Email Service - https://mailtrap.io
MAILTRAP_TOKEN=your_mailtrap_token
MAILTRAP_ENDPOINT=https://sandbox.api.mailtrap.io/api/send/your_mailbox_id
